# CloudOps Sentinel - environment template
# ---------------------------------------------------------------------------
# Copy to .env and edit. .env is gitignored; this file is not, so NEVER put a
# real secret here. Every value below is either a safe default or blank.
#
#   cp .env.example .env
#
# The stack runs correctly with none of these set - they all have defaults in
# docker-compose.yml. Set them when you want to change behaviour.

# --- ports (change if something already owns them locally) -----------------
CONTROL_PLANE_PORT=8000
CHECKOUT_PORT=8081
INVENTORY_PORT=8082
WORKER_PORT=8083
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- application ------------------------------------------------------------
ENVIRONMENT=local
APP_VERSION=1.0.0
LOG_LEVEL=INFO
# json for machine-readable logs (the default, and what a log shipper wants),
# text for readable output while you are debugging locally.
LOG_FORMAT=json

# How often the collector scrapes and generates telemetry.
COLLECT_INTERVAL_SECONDS=10
# How long samples, logs and anomalies are kept before pruning.
RETENTION_HOURS=24
# Synthetic history generated on first boot so the dashboard is useful at once.
BACKFILL_HOURS=6
# Robust z-score threshold. Lower = more sensitive = noisier.
ANOMALY_Z_THRESHOLD=3.5

# --- secrets ----------------------------------------------------------------
# Bearer token for the control plane API. LEAVE BLANK for an unauthenticated
# local demo. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUDOPS_API_TOKEN=

# When true, GET endpoints stay open but incident injection and alert
# acknowledgement require the token above. Useful for a shared demo.
REQUIRE_TOKEN_FOR_WRITES=false

# Optional Alertmanager-compatible webhook. Blank means the webhook sink is not
# registered at all - there is no default endpoint anywhere in the code.
# Try it with:  docker run -p 8090:80 --rm mendhak/http-https-echo:34
ALERT_WEBHOOK_URL=

# --- Grafana ----------------------------------------------------------------
# The admin PASSWORD is not set here. It is read from a file mounted as a
# Docker secret: ./secrets/grafana_admin_password.txt
# Create it with:  make secrets     (or see scripts/bootstrap.sh)
GRAFANA_ADMIN_USER=admin
